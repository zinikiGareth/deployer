This is a sample of how we would deploy an APIGateway (V2) and a Lambda (with versioning)

	target build_lambda_by_hand

In order to build a lambda inside a VPC, you must first have a VPC:

		find aws.VPC.VPC "Test" => vpc

		ensure aws.IAM.Role "trial-lambda-role" => trial_role
			@teardown delete
			Assume <= PolicyStatements
				allow "sts:AssumeRole"
					principal "Service" "lambda.amazonaws.com"
			Inline <= PolicyStatements
				allow aws.action.ec2.CreateNetworkInterface "*"
				allow aws.action.ec2.DescribeNetworkInterfaces "*"
				allow aws.action.ec2.DeleteNetworkInterface "*"

		ensure aws.Lambda.Function "trial-lambda" => lambda
			@teardown delete
			Runtime <- "go"
			Code <= aws.S3.Location
				Bucket <- "zips.gareth.dev.ziniki.org"
				Key <- "lambda-go.zip"
			Role <- trial_role->arn
			VpcConfig <= aws.VPC.Config
				Subnets <- vpc->subnets
				SecurityGroups <- vpc->securityGroups

		lambda.publishVersion
			Name <- lambda->arn
			Alias <- "next"

	target build_lambda

In order to build a lambda inside a VPC, you must first have a VPC:

		find aws.VPC.VPC "Test" => vpc

		lambda.function "trial-lambda"
			@teardown delete
			Runtime <- "go"
			Code <= aws.S3.Location
				Bucket <- "zips.gareth.dev.ziniki.org"
				Key <- "lambda-go.zip"
			Role <= aws.IAM.WithRole "trial-lambda-role"
				assume
					allow "sts:AssumeRole"
						principal "Service" "lambda.amazonaws.com"
				policy
					allow aws.action.ec2.CreateNetworkInterface "*"
					allow aws.action.ec2.DescribeNetworkInterfaces "*"
					allow aws.action.ec2.DeleteNetworkInterface "*"
			PublishVersion <- true
			Alias <- "next"
			VpcConfig <= aws.VPC.Config
				Subnets <- vpc->subnets
				SecurityGroups <- vpc->securityGroups

.		lambda.newVersion
.			PublishVersion <- true
.			Alias <- "next"
.			Code <= aws.S3.Location
.				Bucket <- "zips.gareth.dev.ziniki.org"
.				Key <- "lambda-go.zip"

.		lambda.updateAlias
.			Alias <- "stable"
.			To <- "next"

	target build_gateway_by_hand
		find aws.Lambda.Function "trial-lambda" => trial

		ensure aws.ApiGatewayV2.Api "http-1" => api
			@teardown delete
			Protocol <- "http"

		ensure aws.ApiGatewayV2.Integration "lambda" => use_trial_lambda
			@teardown delete
			Api <- api->id
			Region <- "us-east-1"
			Type <- "AWS_PROXY"
			Uri <- trial->arn

		lambda.addPermissions "gateway_execution"
			allow "lambda:InvokeFunction" (trial->arn)
				principal "Service" "apigateway.amazonaws.com"

		ensure aws.ApiGatewayV2.Route "GET /index" => index_route
			@teardown delete
			Api <- api->id
			Target <- use_trial_lambda->integrationId

		ensure aws.ApiGatewayV2.Route "$default" => default_route
			@teardown delete
			Api <- api->id
			Target <- use_trial_lambda->integrationId

		ensure aws.ApiGatewayV2.Stage "development" => dev_stage
			@teardown delete
			Api <- api->id

The "name" here is not really the unique name of the deployment; they don't have them.
Instead, it is the name of the stage you are deploying into.
Don't blame me; the AWS model is weird.

		ensure aws.ApiGatewayV2.Deployment "development" => dev_deployment
			@teardown delete
			Api <- api->id

It is my impression from studying the documentation that the above is not enough to "re-deploy"
the gateway if auto-deploy is off.  However, it seems to be working.

.		update aws.ApiGatewayV2.Stage "development"
.			Api <- api->id
.			Deployment <- dev_deployment->id

	target build_gateway
		find aws.Lambda.Function "trial-lambda" => trial

		api.gatewayV2 "http-1"
			@teardown delete
			Protocol <- "http"
			integration "lambda"
				Type <- "AWS_PROXY"
				Uri <- trial->arn
			route "GET /index" "lambda"
			route "GET /login" "lambda"
			route "$default" "lambda"
			stage "development"

		api.gatewayV2 "ws-1"
			@teardown delete
			Protocol <- "websocket"
			RouteSelectionExpression <- "$request.body.action"
