This is a sample of how we would deploy an APIGateway (V2) and a Lambda (with versioning)

	target build_lambda
		lambda.function "trial-lambda"
			@teardown delete
			Runtime <- "go"
			Code <= aws.S3.Location
				Bucket <- "zips.gareth.dev.ziniki.org"
				Key <- "lambda-go.zip"
			Role <= aws.IAM.WithRole "trial-lambda-role"
				policy
					allow aws.action.APIGateway.GET aws.resource.APIGatewayV2
			PublishVersion <- true
			Alias <- "next"

.		lambda.newVersion
.			PublishVersion <- true
.			Alias <- "next"
.			Code <= aws.S3.Location
.				Bucket <- "zips.gareth.dev.ziniki.org"
.				Key <- "lambda-go.zip"

.		lambda.updateAlias
.			Alias <- "stable"
.			To <- "next"

	target build_gateway_by_hand
		find aws.Lambda.Function "trial-lambda" => trial

		ensure aws.ApiGatewayV2.Api "http-1" => api
			@teardown delete
			Protocol <- "http"

		ensure aws.ApiGatewayV2.Integration "lambda" => use_trial_lambda
			@teardown delete
			Api <- api->id
			Region <- "us-east-1"
			Type <- "AWS_PROXY"
			Uri <- trial->integrationUri

		ensure aws.ApiGatewayV2.Route "GET /index" => index_route
			@teardown delete
			Api <- api->id
			Target <- use_trial_lambda->integrationId

		ensure aws.ApiGatewayV2.Route "$default" => default_route
			@teardown delete
			Api <- api->id
			Target <- use_trial_lambda->integrationId

		ensure aws.ApiGatewayV2.Stage "development" => dev_stage
			@teardown delete
			Api <- api->id

	target build_gateway
		find aws.Lambda.Function "trial-lambda" => trial

		api.gatewayV2 "http-1"
			@teardown delete
			Protocol <- "http"
			route "/*"
				lambda trial->arn

		api.gatewayV2 "ws-1"
			@teardown delete
			Protocol <- "websocket"
			RouteSelectionExpression <- "$request.body.action"
