	"launch": {
		"configurations": [
			{
				"name": "golden tests",
				"type": "go",
				"request": "launch",
				"program": "${workspaceFolder:GoldenTester}/cmd/golden",
				"cwd": "${workspaceFolder:GoldenTester}",
				"args": [
					"--module",
					"${workspaceFolder:CoreMod}/plugin/coremod.so",
					"--module",
					"${workspaceFolder:TestMod}/plugin/testmod.so",
					"${workspaceFolder:GoldenTester}/goldencases"
				]
			},
			{
				"name": "lambda",
				"type": "go",
				"request": "launch",
				"program": "${workspaceFolder:AWS}/cmd/awsdep",
				"cwd": "${workspaceFolder:Driver}/..",
				"args": [
					"-d",
					"trials",
					// "--teardown",
					"build_lambda_by_hand"
				],
				"env": {
					"AWS_PROFILE": "ziniki-admin",
					"CONSOLIDATOR_SRC": "/Users/gareth/Clients/consolidator.news",
				}
			},
			{
				"name": "trial bucket",
				"type": "go",
				"request": "launch",
				"program": "${workspaceFolder:AWS}/cmd/awsdep",
				"cwd": "${workspaceFolder:Deployer}/..",
				"args": [
					"-d",
					"trials",
					"cloudfront_website_from_bucket"
				],
				"env": {
					"AWS_PROFILE": "ziniki-admin",
					"CONSOLIDATOR_SRC": "/Users/gareth/Clients/consolidator.news"
				}
			},
			{
				"name": "trial db",
				"type": "go",
				"request": "launch",
				"program": "${workspaceFolder:AWS}/cmd/awsdep",
				"cwd": "${workspaceFolder:Driver}/..",
				"args": [
					"-d",
					"trials",
					"trial_dbs"
				],
				"env": {
					"AWS_PROFILE": "ziniki-admin",
				}
			},
			{
				"name": "trial dsql",
				"type": "go",
				"request": "launch",
				"program": "${workspaceFolder:AWS}/cmd/awsdep",
				"cwd": "${workspaceFolder:Driver}/..",
				"args": [
					"-d",
					"trials",
					"-e", "ampleforth",
					"create_aurora_dsql_cluster",
				],
				"env": {
					"AWS_PROFILE": "ziniki-admin",
				}
			},
			{
				"name": "awsdep ziniki",
				"type": "go",
				"request": "launch",
				"program": "${workspaceFolder:AWS}/cmd/awsdep",
				"cwd": "${workspaceFolder:Driver}/../../Tools",
				"args": [
					"-d",
					"deployment",
					"-e", "ampleforth",
					"create_ziniki_tables",
				],
				"env": {
					"AWS_PROFILE": "ziniki-admin",
					"AWS_ENDPOINT": "https://localhost.localstack.cloud:4566/",
					"ENVIRON": "gareth.dev",
					//"ENVIRON": "staging",
				}
			}
		],
		"compounds": []
	},
